         "id": 3,
         "panels": [ ],
         "title": "Traffic",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 10
         },
         "id": 4,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "azureLogAnalytics": {
                  "query": "requests\n| where timestamp > ago(1h)\n| summarize\n    requestCount = count()\n    by bin(timestamp, 5m),\n    operation_Name\n| order by timestamp asc, requestCount desc",
                  "resource": "/subscriptions/81da4d58-2cce-415e-b178-7288e443b4a0/resourceGroups/rg-aks-observability/providers/Microsoft.Insights/components/appi-aduke",
                  "resultFormat": "time_series"
               },
               "datasource": {
                  "type": "grafana-azure-monitor-datasource",
                  "uid": "azure-monitor"
               },
               "queryType": "Azure Log Analytics",
               "refId": "A"
            }
         ],
         "title": "Traffic by Endpoint",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 18
         },
         "id": 5,
         "panels": [ ],
         "title": "Errors",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 19
         },
         "id": 6,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "azureLogAnalytics": {
                  "query": "requests\n| where timestamp > ago(1h)\n| summarize\n    totalRequests = count(),\n    failedRequests = countif(success == false)\n    by operation_Name\n| extend errorRatePercent = round( 100.0 * failedRequests / totalRequests, 2)\n| where totalRequests > 0\n| order by errorRatePercent desc",
                  "resource": "/subscriptions/81da4d58-2cce-415e-b178-7288e443b4a0/resourceGroups/rg-aks-observability/providers/Microsoft.Insights/components/appi-aduke",
                  "resultFormat": "time_series"
               },
               "datasource": {
                  "type": "grafana-azure-monitor-datasource",
                  "uid": "azure-monitor"
               },
               "queryType": "Azure Log Analytics",
               "refId": "A"
            }
         ],
         "title": "Error Rate by Endpoint",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 19
         },
         "id": 7,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "azureLogAnalytics": {
                  "query": "exceptions\n| where timestamp > ago(1h)\n| summarize\n    occurrences = count()\n    by problemId, outerMessage, operation_Name\n| order by occurrences desc\n| take 20",
                  "resource": "/subscriptions/81da4d58-2cce-415e-b178-7288e443b4a0/resourceGroups/rg-aks-observability/providers/Microsoft.Insights/components/appi-aduke",
                  "resultFormat": "time_series"
               },
               "datasource": {
                  "type": "grafana-azure-monitor-datasource",
                  "uid": "azure-monitor"
               },
               "queryType": "Azure Log Analytics",
               "refId": "A"
            }
         ],
         "title": "Top Exceptions",
         "type": "table"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 27
         },
         "id": 8,
         "panels": [ ],
         "title": "Saturation",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 70
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 28
         },
         "id": 9,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "# node_cpu_saturation.promql\n# Purpose: CPU saturation per node, flags node running hot before it translates into user-facing latency/errors.\n100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
               "refId": "A"
            }
         ],
         "title": "Node CPU Saturation",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 28
         },
         "id": 10,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "# pod_memory_saturation.promql\n# Purpose: memory usage as a percentage of each pod's configured limits\n# surfaces pods approaching OOMKill before it actually happens\nsum(container_memory_working_set_bytes{namespace=\"production\"}) by (pod) / \nsum(kube_pod_container_resource_limits{namespace=\"production\", resource=\"memory\"}) by (pod)\n* 100",
               "refId": "A"
            }
         ],
         "title": "Pod Memory Saturation",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 36
         },
         "id": 11,
         "panels": [ ],
         "title": "SLO Status",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "availabilityPercent"
                  },
                  "properties": [
                     {
                        "id": "unit",
                        "value": "percent"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "errorBudgetRemainingPercent"
                  },
                  "properties": [
                     {
                        "id": "unit",
                        "value": "percent"
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 37
         },
         "id": 12,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "azureLogAnalytics": {
                  "query": "// SLI: Percentage of the request that are good (success == true)\n// This is the measured value the availability SLO is judged against\nrequests\n| where timestamp > ago(30d)\n| summarize\n    totalRequests = count(),\n    goodRequests = countif(success == true)\n| extend availabilityPercent = round( 100.0 * goodRequests / totalRequests, 4)\n| extend errorBudgetRemainingPercent = round(availabilityPercent - 99.5, 4)",
                  "resource": "/subscriptions/81da4d58-2cce-415e-b178-7288e443b4a0/resourceGroups/rg-aks-observability/providers/Microsoft.Insights/components/appi-aduke",
                  "resultFormat": "time_series"
               },
               "datasource": {
                  "type": "grafana-azure-monitor-datasource",
                  "uid": "azure-monitor"
               },
               "queryType": "Azure Log Analytics",
               "refId": "A"
            }
         ],
         "title": "Availability Error Budget Remaining",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "percentUnder300ms"
                  },
                  "properties": [
                     {
                        "id": "unit",
                        "value": "percent"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "errorBudgetRemainingPercent"
                  },
                  "properties": [
                     {
                        "id": "unit",
                        "value": "percent"
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 37
         },
         "id": 13,
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "azureLogAnalytics": {
                  "query": "// SLI: percentage of requests completing under the 300ms threshold\nrequests\n| where timestamp > ago(30d)\n| summarize\n    totalRequests = count(),\n    fastRequests = countif(duration < 300)\n| extend percentUnder300ms = round( 100.0 * fastRequests / totalRequests, 4)\n| extend errorBudgetRemainingPercent = round( percentUnder300ms - 95.0, 4)",
                  "resource": "/subscriptions/81da4d58-2cce-415e-b178-7288e443b4a0/resourceGroups/rg-aks-observability/providers/Microsoft.Insights/components/appi-aduke",
                  "resultFormat": "time_series"
               },
               "datasource": {
                  "type": "grafana-azure-monitor-datasource",
                  "uid": "azure-monitor"
               },
               "queryType": "Azure Log Analytics",
               "refId": "A"
            }
         ],
         "title": "Latency Error Budget Remaining",
         "type": "stat"
      }
   ],
